# The single authoritative forecast backend (server.py / dashboard_payload.py,
# deployed per render.yaml). The Worker (dashboard/scripts/create-worker.mjs)
# no longer computes forecasts itself -- it proxies here and adds auth/
# paywall/billing in front. Defaults to https://polyweather-api.onrender.com
# (Render's auto-generated URL for the "polyweather-api" service in
# render.yaml); override for a staging deployment or a custom domain.
FORECAST_API_URL=

# Server-side account ownership (set in Sites runtime variables, not in this file).
WEATHERPICKS_ADMIN_EMAIL=

# REQUIRED for identity to be safe. Without this, the Worker trusts
# oai-authenticated-user-id/-email verbatim from any incoming request with
# no verification -- anyone who can reach this Worker's URL directly can
# forge those headers and impersonate any user, including an admin, by
# setting the admin's email. Set this as a Worker secret, and configure the
# trusted upstream gateway (whatever authenticates the real ChatGPT-Apps
# caller before forwarding to this Worker) to attach the identical value as
# the x-weatherpicks-gateway-secret header on every request it forwards.
# See identityFrom() in dashboard/scripts/create-worker.mjs.
IDENTITY_GATEWAY_SECRET=

# Required before paid subscriptions can be activated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEEKLY_PRICE_ID=
