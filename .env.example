# Copy to .env for local development, or set these as real environment
# variables / secrets in your hosting platform (e.g. Render). server.py and
# polyweather/nws.py read these directly from the process environment; this
# repo does not load .env automatically.

# Comma-separated list of origins allowed to call /api/dashboard, e.g.
# https://weatherpicks.example.com. Leave unset locally to allow any origin
# during development. ALWAYS set this in production (see render.yaml).
ALLOWED_ORIGINS=

# Identifies this app to api.weather.gov per NWS's usage policy, which asks
# for a real way to reach the operator: https://www.weather.gov/documentation/services-web-api
# Falls back to a placeholder that says so if left unset.
NWS_USER_AGENT=

# Set to 1 to enable the Flask debugger when running server.py directly
# with `python server.py`. Never set this in a deployed environment.
FLASK_DEBUG=
